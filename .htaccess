# Situs Slak: pengaturan hosting cPanel (Apache) untuk slak.studio.
# GitHub Pages (salinan resmi slakstudio.github.io) mengabaikan berkas ini.

# Selalu https
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Halaman folder: playground/ -> playground/index.html
DirectoryIndex index.html

# Jenis berkas yang belum dikenal sebagian server
AddType application/manifest+json .webmanifest
AddType application/wasm .wasm
AddType text/javascript .js .mjs
AddType image/svg+xml .svg
AddType text/markdown .md
AddDefaultCharset utf-8

# Kompresi teks
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/wasm text/plain text/markdown
</IfModule>

# Cache: halaman dan service worker selalu diperiksa ulang, berkas lain disimpan 7 hari
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|svg|ico|wasm|json|csv)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
